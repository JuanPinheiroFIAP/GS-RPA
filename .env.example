# Modelo de configuração do robô. Copie para .env e carregue no ambiente (o .env NÃO vai para o Git).
# Todas as variáveis são opcionais. Nunca commite valores reais.

# Pastas (padrões: dados/entrada, saida, estado, logs)
# RPA_ENTRADA=../GS Big Data/chegada
# RPA_SAIDA=saida

# Sal do hash do autor (LGPD). Gere um valor aleatório longo: python -c "import secrets; print(secrets.token_hex(32))"
# Sem ele o robô usa um sal de desenvolvimento e avisa no log.
RPA_SAL_LGPD_SECRET=

# Webhook do Discord ou Slack para avisar alertas novos. Vazio = só log e arquivo.
RPA_WEBHOOK_URL_SECRET=
